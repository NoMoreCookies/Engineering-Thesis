# Uruchom raz:
install.packages("fpp3")
library(fpp3)
# Hierarchia: Australia → stan → region
# Sumujemy także po celach podróży.
dane_hierarchiczne <- tourism |>
aggregate_key(
State / Region,
Trips = sum(Trips)
)
# Wykres kraju i poszczególnych stanów
dane_hierarchiczne |>
filter(is_aggregated(Region)) |>
autoplot(Trips) +
facet_wrap(vars(State), scales = "free_y") +
labs(
x = "Kwartał",
y = "Liczba podróży [tys.]"
) +
theme(legend.position = "none")
