N <- n + m
mi <- n*(n+m+1)/2
sigma_kw <- m*n*(n+m+1)/12
podzbiory_rang <- combn(N, n)
print(podzbiory_rang)
print(podzbiory_rang[1,])
print(podzbiory_rang[,1])
kwantyl <- 0
for (col in ncols(podzbiory_rang)){
kwantyl <- kwantyl + choose(N,n)
}
kwantyl <- 0
for (col in cols(podzbiory_rang)){
kwantyl <- kwantyl + choose(N,n)
}
