for (1 in 1:ncol(podzbiory_rang)){
kwantyl <- 0
for 1 in 1:ncol(podzbiory_rang){
kwantyl <- 0
for i in 1:ncol(podzbiory_rang){
kwantyl <- 0
for (i in 1:ncol(podzbiory_rang)){
